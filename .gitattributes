* text=auto eol=lf

# Go sources go through gofmt, which is LF-only.
*.go text eol=lf

# Shell scripts and the Makefile keep LF everywhere.
*.sh text eol=lf
Makefile text eol=lf

# Generated handler scripts are POSIX sh too.
bin/handler-* text eol=lf

# Binary assets are never normalized.
*.png binary
*.ico binary
*.woff2 binary
